rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check valid string
    function isNonEmptyString(text) {
      return text is string && text.size() > 0;
    }

    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to verify document ownership or legacy post without user_id
    function isOwner(data) {
      return isSignedIn() && (!('user_id' in data) || data.user_id == null || data.user_id == request.auth.uid);
    }

    // 1. Posts Collection: Strict validation, immutability & creator ownership
    match /posts/{postId} {
      // Only the authenticated creator can read their own posts
      allow read: if isOwner(resource.data);

      // Only signed-in creators can create posts, and must tag it with their own UID
      allow create: if isSignedIn()
                    && ('user_id' in request.resource.data)
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.post_type in ['trial', 'public']
                    && request.resource.data.slot_source in ['algorithm', 'user']
                    && isNonEmptyString(request.resource.data.posted_at);

      // Updates allowed ONLY by the creator owner.
      // Two permitted update paths:
      //   (A) Standard check-in update: post_type, posted_at, slot_source stay immutable
      //   (B) Trial → Public promotion: post_type may change trial→public, posted_at may reset
      allow update: if isOwner(resource.data)
                    && (!('user_id' in resource.data) || resource.data.user_id == null || request.resource.data.user_id == resource.data.user_id)
                    && request.resource.data.slot_source == resource.data.slot_source
                    && (request.resource.data.views_24h == null || request.resource.data.views_24h is number)
                    && (
                      // Path A: Standard update — post_type and posted_at are immutable
                      (
                        request.resource.data.post_type == resource.data.post_type
                        && request.resource.data.posted_at == resource.data.posted_at
                      )
                      ||
                      // Path B: Trial → Public promotion — only this direction is permitted
                      (
                        resource.data.post_type == 'trial'
                        && request.resource.data.post_type == 'public'
                        && request.resource.data.views_24h == null
                      )
                    );

      // Only the creator owner can delete their post
      allow delete: if isOwner(resource.data);
    }

    // 2. External Signals Collection (Weekly Platform Notes)
    match /external_signals/{signalId} {
      // Only the authenticated owner can read their own notes
      allow read: if isOwner(resource.data);

      // Only signed-in creators can create notes, must tag with their UID
      allow create: if isSignedIn()
                    && ('user_id' in request.resource.data)
                    && request.resource.data.user_id == request.auth.uid
                    && isNonEmptyString(request.resource.data.week_of)
                    && isNonEmptyString(request.resource.data.note_text);

      // Updates allowed ONLY by the note owner
      allow update: if isOwner(resource.data)
                    && request.resource.data.user_id == resource.data.user_id
                    && isNonEmptyString(request.resource.data.week_of)
                    && isNonEmptyString(request.resource.data.note_text);

      // Only the owner can delete their note
      allow delete: if isOwner(resource.data);
    }

    // 3. User Profiles Collection (Creator Onboarding & Profile Settings)
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Default: Deny all other collections for strict security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
